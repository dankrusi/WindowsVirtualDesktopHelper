{
    "version": "{version}",
    "description": "Simple and lightweight app to help with Virtual Desktops for Windows 11.",
    "homepage": "https://github.com/dankrusi/WindowsVirtualDesktopHelper",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "{x64-url}",
            "hash": "{x64-hash}"
        },
        "32bit": {
            "url": "{x86-url}",
            "hash": "{x86-hash}"
        },
        "arm64": {
            "url": "{arm64-url}",
            "hash": "{arm64-hash}"
        }
    },
    "shortcuts": [
        [
            "WindowsVirtualDesktopHelper.exe",
            "Windows Virtual Desktop Helper"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dankrusi/WindowsVirtualDesktopHelper/releases/download/v$version/WindowsVirtualDesktopHelper.Executable.v$version.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            },
            "32bit": {
                "url": "https://github.com/dankrusi/WindowsVirtualDesktopHelper/releases/download/v$version/WindowsVirtualDesktopHelper.Executable.v$version.x86.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            },
            "arm64": {
                "url": "https://github.com/dankrusi/WindowsVirtualDesktopHelper/releases/download/v$version/WindowsVirtualDesktopHelper.Executable.v$version.arm64.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    },
    "notes": "Settings requires Microsoft Windows App Runtime 2.4 or later (matching architecture). Install it from https://learn.microsoft.com/windows/apps/windows-app-sdk/downloads or use: winget install --id Microsoft.WindowsAppRuntime.2 --exact --source winget"
}
