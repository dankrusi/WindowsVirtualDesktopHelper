<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">
  <Identity Name="WindowsVirtualDesktopHelper.Development" Publisher="CN=WindowsVirtualDesktopHelper Development" Version="2.1.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Windows Virtual Desktop Helper</DisplayName>
    <PublisherDisplayName>Dan Krusi</PublisherDisplayName>
    <Description>Tray icons, overlays, and hotkeys for Windows virtual desktops.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Applications>
    <Application Id="App" Executable="WindowsVirtualDesktopHelper.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Windows Virtual Desktop Helper"
        Description="Tray icons, overlays, and hotkeys for Windows virtual desktops."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="WindowsVirtualDesktopHelper.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="WindowsVirtualDesktopHelperStartup" Enabled="false" DisplayName="Windows Virtual Desktop Helper" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
